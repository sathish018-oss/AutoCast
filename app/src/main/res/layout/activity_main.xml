<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".MainActivity">

    <!-- App Title & Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AutoCast Pro"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textColor="@color/teal_200"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Controls Row: Mode Toggle & Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleModeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:checkedButton="@id/btnYouTubeMode">

            <Button
                android:id="@+id/btnYouTubeMode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnScreenCastMode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Cast"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/start_mirroring"
            android:backgroundTint="@color/red_youtube"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- YouTube Search & Control Bar -->
    <LinearLayout
        android:id="@+id/youtubeBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#222222"
            android:hint="Search YouTube videos..."
            android:textColorHint="#888888"
            android:textColor="@color/white"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="Search"
            android:textSize="12sp"
            android:backgroundTint="@color/red_youtube" />

        <Button
            android:id="@+id/btnHome"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:text="Home"
            android:textSize="12sp"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- YouTube Video Stream Container -->
    <FrameLayout
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:layout_marginBottom="8dp">

        <WebView
            android:id="@+id/youtubeWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvScreenCastPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Screen Cast Active\n\nAll apps (YouTube app, Netflix, Chrome) opened on phone are now mirrored to Android Auto"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:background="#111111"
            android:visibility="gone"
            android:padding="24dp" />
    </FrameLayout>

    <!-- System Permission Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnOverlayPermission"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Grant Overlay Permission"
            android:textColor="@color/teal_200"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnAccessibilityPermission"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Touch Passthrough"
            android:textColor="@color/teal_200"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActiveMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mode: YouTube Widescreen"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

</LinearLayout>
